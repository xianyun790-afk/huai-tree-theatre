  "dialogues": {
    "intro": {
      "speaker": "{{playerName}}",
      "portrait": "neighbor",
      "caption": "你的意识 / 邻居老何的身体",
      "lines": [
        "只有你和老何换了身体。阿岚修机器，老爸看热闹，其他人都没变。",
        "黄圈里的灰发邻居就是你控制的人。酒吧前长得像你的人，里面是老何。",
        "先问红发阿岚，然后拿证据、说服老何、换回来。"
      ],
      "choices": [
        {
          "id": "start",
          "label": "明白，先去问阿岚"
        }
      ]
    },
    "briefing": {
      "speaker": "阿岚",
      "portrait": "inventor",
      "caption": "发明家 · 帮你修机器",
      "lines": [
        "我还是阿岚，你爸还是你爸。只有你和老何交换了身体。",
        "查一下实验台，再去你家的信箱拿报名表。老何已经替你报了相亲班，有了证据再让他配合。"
      ],
      "choices": [
        {
          "id": "understood",
          "label": "知道了，先查实验台",
          "effects": [
            {
              "type": "flag",
              "key": "briefed",
              "value": true
            }
          ]
        }
      ]
    },
    "reminder": {
      "speaker": "阿岚",
      "portrait": "inventor",
      "caption": "发明家 · 你的帮手",
      "lines": [
        "现在照左上角黄色按钮做就行。你拿到证据，让老何愿意回来，我负责把机器修好。"
      ],
      "choices": [
        {
          "id": "continue",
          "label": "我继续调查"
        }
      ]
    },
    "father": {
      "speaker": "老周",
      "portrait": "father",
      "caption": "你爸 · 身体没变，正在看热闹",
      "lines": [
        "放心，我没换身。你和老何的事情，我完全看懂了。",
        "那张相亲报名表在咱家信箱里。拿回来，别让他替你决定人生。"
      ],
      "choices": [
        {
          "id": "stop_filming",
          "label": "爸，你至少别拍视频"
